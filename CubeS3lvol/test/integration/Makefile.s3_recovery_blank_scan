#
# Standalone build for s3_recovery_blank_scan_test.c.
#
# The scanner is compiled with function/data sections and linked with
# --gc-sections, so the unrelated recovery functions in s3_recovery.c are
# discarded. Every SPDK bdev / channel / DMA symbol the blank-scan path uses is
# redirected with --wrap to the mock in the test, so no SPDK archive, bdev
# module or hardware is required.
#
# Inside the offline builder container the project is at /work:
#   make -f /work/test/integration/Makefile.s3_recovery_blank_scan \
#        WORK=/work TARGET=/evid/s3_recovery_blank_scan_test.fixed
#
# To build the pre-fix copy instead:
#   make -f .../Makefile.s3_recovery_blank_scan \
#        SCANNER_SRC=/evid/baseline/s3_recovery.c \
#        TARGET=/evid/s3_recovery_blank_scan_test.baseline
#
# Defaults build the working-tree scanner into /tmp.

CC ?= cc
WORK ?= /work

CFLAGS ?= -I$(WORK)/include -I$(WORK)/deps/spdk/include \
	-Wall -Wextra -Wno-unused-parameter -Werror \
	-DDEBUG -g3 -O0 -D_GNU_SOURCE -fno-strict-aliasing \
	-ffunction-sections -fdata-sections

SCANNER_SRC ?= $(WORK)/lib/s3bsdev/s3_recovery.c
TEST_SRC ?= $(WORK)/test/integration/s3_recovery_blank_scan_test.c
TARGET ?= /tmp/s3_recovery_blank_scan_test
OBJ := $(TARGET).scanner.o

WRAPS := \
	-Wl,--wrap=spdk_bdev_open_ext \
	-Wl,--wrap=spdk_bdev_close \
	-Wl,--wrap=spdk_bdev_desc_get_bdev \
	-Wl,--wrap=spdk_bdev_get_block_size \
	-Wl,--wrap=spdk_bdev_get_num_blocks \
	-Wl,--wrap=spdk_bdev_get_name \
	-Wl,--wrap=spdk_bdev_get_io_channel \
	-Wl,--wrap=spdk_put_io_channel \
	-Wl,--wrap=spdk_bdev_read \
	-Wl,--wrap=spdk_bdev_free_io \
	-Wl,--wrap=spdk_dma_zmalloc \
	-Wl,--wrap=spdk_dma_free \
	-Wl,--wrap=spdk_log

all: $(TARGET)

$(TARGET): $(SCANNER_SRC) $(TEST_SRC)
	$(CC) $(CFLAGS) -c $(SCANNER_SRC) -o $(OBJ)
	$(CC) $(CFLAGS) $(TEST_SRC) $(OBJ) $(WRAPS) -Wl,--gc-sections -o $(TARGET)

clean:
	rm -f $(OBJ) $(TARGET)
